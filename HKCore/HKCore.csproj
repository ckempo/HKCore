<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>default</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
